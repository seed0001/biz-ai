# OpenRouter (https://openrouter.ai) powers the AI assistant (src/app/api/ai/route.ts).
# Create a key at https://openrouter.ai/keys, then copy this file to .env.local
# and paste it in. .env.local is gitignored — never commit a real key.
OPENROUTER_API_KEY=

# Optional: overrides the model when a request doesn't specify one (or when the
# requested model errors out and the server falls back). Must be a valid
# OpenRouter model id — check https://openrouter.ai/models.
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
